[init]
  defaultBranch = main
[user]
  email = abbaadamu302@icloud.com
	name = shytypes
  signingkey = B87CC68CF426C819
[http]
  version = HTTP/2
  postBuffer = 524288000
[core]
  excludesfile = /Users/abba/.gitignore_global
  editor = nvim
[diff]
  colorMoved = default
  tool = nvimdiff
[difftool "nvimdiff"]
  cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""
[difftool]
  prompt = false
[merge]
  conflictstyle = diff3
  tool = nvimdiff
[mergetool]
  prompt = true
  keepBackup = false
[mergetool "nvimdiff"]
  cmd = "nvim -d \"$LOCAL\" \"$REMOTE\" \"$MERGED\" -c 'wincmd w' -c 'wincmd J'"
[commit]
	gpgsign = true
	signoff = true
  verbose = true
[gpg]
  program = gpg
[tag]
  forceSignAnnotated = true
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
