# adds LSP servers, linters, formatters etc installed by `mason-org/mason.nvim` to the PATH,
# so that they can be used by opencode or any tool that needs them i hate having to manage them
# In mutliple places
export PATH=$HOME/.local/share/nvim/mason/bin:$PATH
export GH_COPILOT_USE_HELIX_FETCHER=true

