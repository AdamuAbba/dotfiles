# vim: ft=ghostty

# ============================================= General config =============================================
theme = Monokai Remastered
font-family = "IosevkaInput"
# fallback to Symbols Nerd Font for icons
font-family = "Symbols Nerd Font Mono"
font-size = 17
adjust-underline-position = 7%
adjust-cursor-thickness = 150%
macos-titlebar-style = tabs
macos-option-as-alt = true
mouse-hide-while-typing = true
maximize = true
cursor-style-blink = false
shell-integration-features = no-cursor
quit-after-last-window-closed = true
clipboard-paste-protection = false
link-previews = true
link-url = true
copy-on-select = clipboard
confirm-close-surface = false
progress-style = true

#--- Clipboard settings
clipboard-read = allow
clipboard-write = allow

#--- window settings
window-title-font-family = "IosevkaInput"
window-save-state = never
window-padding-y = 5
window-padding-x = 5
window-padding-balance = true
window-inherit-working-directory = true
window-theme = dark
window-new-tab-position = current
window-width = 148
window-height = 47

#--- tab settings
tab-inherit-working-directory = true

#--- split settings
split-inherit-working-directory = true
split-divider-color=#ffffff

# ============================================= colors =============================================
background = #000000
cursor-color = #ffffff
cursor-text = #000000
selection-background = #44475a
selection-foreground = #ffffff
shell-integration = zsh
keybind = clear
keybind = ctrl+shift+t>n=new_tab
keybind = ctrl+shift+t>x=close_tab
keybind = ctrl+shift+]=next_tab
keybind = ctrl+shift+[=previous_tab
keybind = ctrl+shift+p>l=new_split:right
keybind = ctrl+shift+p>j=new_split:down
keybind = ctrl+shift+p>h=new_split:left
keybind = ctrl+shift+p>k=new_split:up
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+u=scroll_page_lines:-6
keybind = ctrl+shift+d=scroll_page_lines:6
keybind = copy=copy_to_clipboard:mixed
keybind = paste=paste_from_clipboard
keybind = cmd+c=copy_to_clipboard:mixed
keybind = cmd+v=paste_from_clipboard

