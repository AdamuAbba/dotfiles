{
  "items": [
    {
      "key": "p",
      "type": "group",
      "description": "pane",
      "items": [
        {
          "key": "v",
          "type": "tmux",
          "command": "split-window -h -c '#{pane_current_path}'",
          "description": "Split vertical"
        },
        {
          "key": "s",
          "type": "tmux",
          "command": "split-window -v -c '#{pane_current_path}'",
          "description": "Split horizontal"
        },
        {
          "key": "h",
          "type": "tmux",
          "command": "select-pane -L",
          "description": "Select left"
        },
        {
          "key": "j",
          "type": "tmux",
          "command": "select-pane -D",
          "description": "Select down"
        },
        {
          "key": "k",
          "type": "tmux",
          "command": "select-pane -U",
          "description": "Select up"
        },
        {
          "key": "l",
          "type": "tmux",
          "command": "select-pane -R",
          "description": "Select right"
        },
        {
          "key": "z",
          "type": "tmux",
          "command": "resize-pane -Z",
          "description": "Zoom toggle"
        },
        {
          "key": "x",
          "type": "tmux",
          "command": "confirm-before -p 'Kill pane? (y/n)' kill-pane",
          "description": "Kill pane"
        },
        {
          "key": "o",
          "type": "tmux",
          "command": "last-pane",
          "description": "Last pane"
        },
        {
          "key": "!",
          "type": "tmux",
          "command": "break-pane",
          "description": "Break to window"
        },
        {
          "key": "J",
          "type": "tmux",
          "command": "command-prompt -p 'Join from pane:' 'join-pane -s \"%%\"'",
          "description": "Join pane"
        },
        {
          "key": "m",
          "type": "tmux",
          "command": "select-pane -m",
          "description": "Mark pane"
        },
        {
          "key": "M",
          "type": "tmux",
          "command": "select-pane -M",
          "description": "Unmark pane"
        },
        {
          "key": "{",
          "type": "tmux",
          "command": "swap-pane -U",
          "description": "Swap up"
        },
        {
          "key": "}",
          "type": "tmux",
          "command": "swap-pane -D",
          "description": "Swap down"
        },
        {
          "key": "c",
          "type": "tmux",
          "command": "clear-history",
          "description": "Clear history"
        },
        {
          "key": "q",
          "type": "tmux",
          "command": "capture-pane",
          "description": "Capture to buffer"
        },
        {
          "key": "p",
          "type": "tmux",
          "command": "respawn-pane -k",
          "description": "Respawn pane"
        },
        {
          "key": "r",
          "type": "group",
          "description": "resize",
          "items": [
            {
              "key": "h",
              "type": "tmux",
              "command": "resize-pane -L 5",
              "description": "Resize left"
            },
            {
              "key": "j",
              "type": "tmux",
              "command": "resize-pane -D 5",
              "description": "Resize down"
            },
            {
              "key": "k",
              "type": "tmux",
              "command": "resize-pane -U 5",
              "description": "Resize up"
            },
            {
              "key": "l",
              "type": "tmux",
              "command": "resize-pane -R 5",
              "description": "Resize right"
            }
          ]
        }
      ]
    },
    {
      "key": "w",
      "type": "group",
      "description": "window",
      "items": [
        {
          "key": "n",
          "type": "tmux",
          "command": "new-window -c '#{pane_current_path}'",
          "description": "New window"
        },
        {
          "key": "x",
          "type": "tmux",
          "command": "confirm-before -p 'Kill window? (y/n)' kill-window",
          "description": "Kill window"
        },
        {
          "key": "r",
          "type": "tmux",
          "command": "command-prompt -I '#W' 'rename-window \"%%\"'",
          "description": "Rename"
        },
        {
          "key": "f",
          "type": "popup",
          "command": "tmux list-windows -a -F '#S:#I  #{window_name}  [#{pane_current_command}]' | less",
          "description": "Find window"
        },
        {
          "key": "l",
          "type": "tmux",
          "command": "last-window",
          "description": "Last window"
        },
        {
          "key": ".",
          "type": "tmux",
          "command": "next-window",
          "description": "Next"
        },
        {
          "key": ",",
          "type": "tmux",
          "command": "previous-window",
          "description": "Previous"
        },
        {
          "key": "w",
          "type": "tmux",
          "command": "choose-tree -w",
          "description": "Choose window"
        },
        {
          "key": "m",
          "type": "tmux",
          "command": "command-prompt -p 'Move to:' 'move-window -t \"%%\"'",
          "description": "Move window"
        },
        {
          "key": "s",
          "type": "tmux",
          "command": "command-prompt -p 'Swap with:' 'swap-window -t \"%%\"'",
          "description": "Swap window"
        },
        {
          "key": "R",
          "type": "tmux",
          "command": "rotate-window",
          "description": "Rotate panes"
        }
      ]
    },
    {
      "key": "c",
      "type": "group",
      "description": "client",
      "items": [
        {
          "key": "l",
          "type": "tmux",
          "command": "list-clients",
          "description": "List clients"
        },
        {
          "key": "c",
          "type": "tmux",
          "command": "choose-client",
          "description": "Choose client"
        },
        {
          "key": "d",
          "type": "tmux",
          "command": "detach-client",
          "description": "Detach"
        },
        {
          "key": "D",
          "type": "tmux",
          "command": "choose-client -Z \"detach-client -t '%%'\"",
          "description": "Detach other"
        },
        {
          "key": "r",
          "type": "tmux",
          "command": "refresh-client",
          "description": "Refresh"
        },
        {
          "key": "s",
          "type": "tmux",
          "command": "suspend-client",
          "description": "Suspend"
        },
        {
          "key": "L",
          "type": "tmux",
          "command": "lock-client",
          "description": "Lock"
        }
      ]
    },
    {
      "key": ":",
      "type": "tmux",
      "command": "command-prompt",
      "description": "Command prompt"
    },
    {
      "key": "r",
      "type": "tmux",
      "command": "source-file ~/.config/tmux/tmux.conf \\; display-message 'config reloaded'",
      "description": "Reload config"
    },
    {
      "key": "?",
      "type": "popup",
      "command": "tmux list-keys | less",
      "description": "List keybindings"
    }
  ]
}
